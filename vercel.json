{
  "headers": [
    {
      "source": "/.well-known/vercel/blob/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, PUT, OPTIONS"
        }
      ]
    }
  ]
}